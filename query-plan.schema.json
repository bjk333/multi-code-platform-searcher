{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "plannerVersion",
    "query",
    "normalizedQuery",
    "queryType",
    "confidence",
    "entities",
    "sources",
    "repositories",
    "reuseCandidates",
    "compatibilityRisks",
    "verificationPlan"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "plannerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "normalizedQuery": {
      "type": "string",
      "minLength": 1
    },
    "queryType": {
      "enum": [
        "research_only",
        "repository_only",
        "code_evidence_only",
        "integrated_research_and_code"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "entities": {
      "type": "object",
      "required": [
        "frameworks",
        "versions",
        "negations"
      ],
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engineCandidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Optional registry engine IDs for the selected planner mode; integrated mode lists the complete x-engineCatalog inventory. x-engineCatalog is maintenance metadata, not an output field."
    },
    "reuseCandidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibilityRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "x-engineCatalog": {
    "GitHub": {
      "kind": "repo",
      "platforms": [
        "GitHub"
      ],
      "func": "Search-GitHub",
      "needs": [
        "Write-ColorOutput",
        "Get-ApiHeaders",
        "Invoke-ApiRequest",
        "Wait-RateLimitToken",
        "Get-StaleCacheResult",
        "Get-Cache",
        "Add-EngineWarning",
        "Get-GitHubStaleFallback",
        "New-EngineEnvelope"
      ]
    },
